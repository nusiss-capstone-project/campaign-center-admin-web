{
  "name": "campaign-center-admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:high": "npm audit --audit-level=high",
    "ci:check": "npm run lint && npm run typecheck && npm run build",
    "gen:api": "openapi --input https://campaign-center-api-dev.up.railway.app/campaign-center-api/v1/swagger/doc.json --output src/lib/api --client fetch && node scripts/strip-generated-eslint-disable.mjs",
    "gen:api:reward": "openapi --input https://campaignhub.best/reward-ms/v1/swagger/doc.json --output src/lib/reward-api --client fetch && node scripts/patch-reward-api-core.mjs && node scripts/strip-generated-eslint-disable.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-day-picker": "^10.0.0",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "openapi-typescript-codegen": "^0.30.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "minimatch": "^10.0.3",
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
